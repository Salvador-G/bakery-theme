---
import type { ImagenData } from "../lib/schema";

interface Props {
  imagen: ImagenData;
  aspectClass?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "auto" | "low";
}

const {
  imagen,
  aspectClass = "aspect-4/3",
  loading = "lazy",
  fetchpriority = "auto",
} = Astro.props;

const hasSrc = Boolean(imagen.src && imagen.src.trim() !== "");
---

<div
  class={`relative overflow-hidden bg-surface-alt border border-ink/15 rounded-(--radius-ui) ${aspectClass}`}
>
  {
    hasSrc ? (
      <img
        src={imagen.src}
        alt={imagen.alt}
        loading={loading}
        fetchpriority={fetchpriority}
        class="w-full h-full object-cover"
      />
    ) : (
      <div
        role="img"
        aria-label={imagen.alt}
        class="w-full h-full flex flex-col items-center justify-center p-6 text-center bg-primary/10 text-ink/80"
      >
        <span class="text-xs tracking-wide border-b border-ink/15 pb-1 mb-2 text-accent">
          Espacio fotográfico
        </span>
        <p class="text-sm max-w-xs">{imagen.placeholder}</p>
      </div>
    )
  }
</div>
