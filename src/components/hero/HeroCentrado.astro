---
import type { SiteData } from "../../lib/schema";
import ImagenMarco from "../ImagenMarco.astro";

interface Props {
  site: SiteData;
}

const { site } = Astro.props;
const { hero, negocio } = site;
---

<section class="py-(--space-section) px-5 md:px-10 border-b border-ink/15">
  <div class="max-w-5xl mx-auto text-center space-y-6">
    <p class="text-xs uppercase tracking-widest text-accent">
      {hero.etiqueta} — {negocio.distrito}
    </p>
    <h1
      class="font-heading text-4xl sm:text-6xl leading-[1.06] text-ink max-w-4xl mx-auto"
    >
      {hero.titulo}
    </h1>
    <p
      class="text-base sm:text-lg text-ink/80 max-w-2xl mx-auto leading-relaxed"
    >
      {hero.subtitulo}
    </p>
    <div class="pt-2 flex flex-wrap justify-center items-center gap-5">
      <a
        href={hero.ctaPrimario.url}
        class="px-7 py-3.5 bg-primary text-on-primary hover:bg-primary-hover rounded-(--radius-ui) border border-primary text-sm font-medium motion-safe:transition-colors"
      >
        {hero.ctaPrimario.texto}
      </a>
      {
        hero.ctaSecundario && (
          <a
            href={hero.ctaSecundario.url}
            class="px-6 py-3.5 border border-ink/15 text-ink hover:border-ink rounded-(--radius-ui) text-sm underline underline-offset-4 motion-safe:transition-colors"
          >
            {hero.ctaSecundario.texto}
          </a>
        )
      }
    </div>

    <div class="pt-8">
      <ImagenMarco
        imagen={hero.imagen}
        aspectClass="aspect-16/9"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
