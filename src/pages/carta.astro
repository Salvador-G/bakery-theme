---
import Layout from "../layouts/Layout.astro";
import rawSite from "../data/site.json";
import { getValidatedSite } from "../lib/publish-guard";
import ImagenMarco from "../components/ImagenMarco.astro";

const { site } = getValidatedSite(rawSite);
const mostrarPrecios = site.flags.mostrarPrecios;

const formatPen = (val: number | null, desde: boolean) => {
  if (val === null) return desde ? "Según tamaño" : "";
  const num = `S/ ${val.toFixed(2)}`;
  return desde ? `Desde ${num}` : num;
};

const cleanPhone =
  site.contacto.whatsapp.replace(/[^\d]/g, "") || "51900000000";
const waCartaHref = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(
  `Hola ${site.negocio.nombre}, tengo una consulta sobre los productos de la carta.`,
)}`;
---

<Layout
  title={`Carta completa | ${site.negocio.nombre}`}
  description={`Carta actualizada de ${site.negocio.nombre} en ${site.negocio.distrito}, ${site.negocio.ciudad}.`}
  pathname="/carta"
>
  <section class="py-16 px-5 md:px-10 border-b border-ink/15">
    <div class="max-w-5xl mx-auto space-y-4">
      <h1 class="font-heading text-4xl sm:text-6xl text-ink">Nuestra Carta</h1>
      <p class="text-base text-ink/80 max-w-2xl">
        {site.negocio.lema}. {mostrarPrecios && site.footer.notaLegal}
      </p>
    </div>
  </section>

  <nav
    aria-label="Categorías de la carta"
    class="sticky top-20 z-30 bg-surface/95 backdrop-blur-xs border-b border-ink/15 px-5 md:px-10 overflow-x-auto"
  >
    <ul
      class="max-w-5xl mx-auto flex items-center gap-6 py-3.5 text-sm whitespace-nowrap"
    >
      {
        site.carta.categorias.map((cat) => (
          <li>
            <a
              href={`#${cat.id}`}
              class="text-ink/80 hover:text-ink underline-offset-4 hover:underline"
            >
              {cat.nombre}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="max-w-5xl mx-auto px-5 md:px-10 py-(--space-section) space-y-20">
    {
      site.carta.categorias.map((cat) => (
        <section id={cat.id} class="scroll-mt-36 space-y-8">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center border-b border-ink/15 pb-8">
            <div class="md:col-span-7 space-y-2">
              <h2 class="font-heading text-3xl sm:text-4xl text-ink">
                {cat.nombre}
              </h2>
              {cat.descripcion && (
                <p class="text-sm text-ink/80">{cat.descripcion}</p>
              )}
            </div>
            <div class="md:col-span-5">
              <ImagenMarco imagen={cat.imagen} aspectClass="aspect-16/10" />
            </div>
          </div>

          <ul class="space-y-6">
            {cat.items.map((item) => (
              <li class="space-y-1.5">
                <div class="flex items-baseline gap-3">
                  <h3 class="font-sans text-base font-medium text-ink">
                    {item.nombre}
                  </h3>
                  <span class="flex-1 border-b border-dotted border-ink/30" />
                  {mostrarPrecios && (
                    <span class="text-base font-medium text-ink shrink-0">
                      {formatPen(item.precio, item.precioDesde)}
                    </span>
                  )}
                </div>
                {item.descripcion && (
                  <p class="text-sm text-ink/80 max-w-2xl">
                    {item.descripcion}
                  </p>
                )}
                {item.alergenos.length > 0 && (
                  <p class="text-xs text-ink/65">
                    Alérgenos: {item.alergenos.join(", ")}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <aside
      aria-label="Aviso sobre alérgenos"
      class="bg-surface-alt border border-ink/15 p-6 sm:p-8 rounded-(--radius-ui) space-y-5"
    >
      <div class="space-y-2">
        <h2 class="font-heading text-2xl text-ink">
          Información sobre alérgenos e intolerancias
        </h2>
        <p class="text-sm text-ink/80 leading-relaxed">
          {site.carta.avisoAlergenos}
        </p>
      </div>
      <div>
        <a
          href={waCartaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-6 py-3 bg-primary text-on-primary hover:bg-primary-hover rounded-(--radius-ui) border border-primary text-sm font-medium motion-safe:transition-colors"
        >
          Consultar por WhatsApp
        </a>
      </div>
    </aside>
  </div>
</Layout>
